# ResolveIT Enterprise Helpdesk Environment Configuration Example
# Copy this file to .env and replace placeholder values with cryptographically secure secrets.

# ==========================================
# POSTGRES DATABASE CONFIGURATION
# ==========================================
POSTGRES_DB=resolveit_db
POSTGRES_USER=resolveit_app
# Generate secure password with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_production_password_here

# ==========================================
# APPLICATION & SECURITY (JWT)
# ==========================================
SPRING_PROFILES_ACTIVE=dev
# Base64-encoded 256-bit secret. Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_base64_encoded_256_bit_random_secret_string
JWT_ACCESS_EXPIRATION_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000   # 7 days

# ==========================================
# CORS & INGRESS CONFIGURATION
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost
VITE_API_BASE_URL=/api/v1
